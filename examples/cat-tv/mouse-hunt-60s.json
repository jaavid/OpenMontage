{
  "name": "mouse-hunt-60s",
  "pipeline": "cat-tv",
  "description": "Deterministic 60-second Cat TV mouse-hunt production recipe with a procedural forest floor, low-angle framing, and resumable rendering.",
  "motion": {
    "operation": "generate",
    "prey_type": "mouse",
    "duration_seconds": 60,
    "fps": 60,
    "seed": 184321,
    "bounds": [-4.0, 4.0, -2.0, 2.0],
    "z_offset": 0.025,
    "target_height": 0.34,
    "output_path": "projects/cat-tv/mouse-hunt-60s/mouse.motion.json"
  },
  "world": {
    "operation": "build",
    "width": 1920,
    "height": 1080,
    "fps": 60,
    "duration_seconds": 60,
    "blend_path": "projects/cat-tv/mouse-hunt-60s/base.blend",
    "world_spec": {
      "seed": 184321,
      "fps": 60,
      "terrain": {
        "size": 22,
        "resolution": 128,
        "height_scale": 0.14,
        "frequency": 0.052,
        "palette": [
          [0.19, 0.28, 0.105, 1.0],
          [0.28, 0.34, 0.12, 1.0],
          [0.31, 0.22, 0.105, 1.0]
        ]
      },
      "camera": {
        "position": [0.0, -10.3, 3.9],
        "target": [0.0, 0.6, 0.14],
        "lens": 46
      },
      "lighting": {
        "sun_energy": 2.35,
        "sun_angle_degrees": 32,
        "sun_rotation_degrees": [36, -24, -31],
        "fill_energy": 780,
        "world_color": [0.17, 0.21, 0.115, 1],
        "world_strength": 0.58
      }
    }
  },
  "prey_render": {
    "operation": "render_animation",
    "base_blend_path": "projects/cat-tv/mouse-hunt-60s/base.blend",
    "asset_path": "${MOUSE_GLB_PATH}",
    "motion_plan_path": "projects/cat-tv/mouse-hunt-60s/mouse.motion.json",
    "blend_path": "projects/cat-tv/mouse-hunt-60s/mouse-hunt.blend",
    "output_path": "projects/cat-tv/mouse-hunt-60s/frames/frame-",
    "target_height": 0.34,
    "fps": 60,
    "start_frame": 1,
    "end_frame": 3600,
    "resume": true,
    "seconds_per_frame_budget": 8.0,
    "decorate_world": true
  },
  "sample_policy": {
    "required": true,
    "duration_seconds": 12,
    "review": [
      "prey occupies a clearly trackable portion of the frame",
      "prey scale and ground contact",
      "body motion reduces the sliding impression without excessive bouncing",
      "visibility transitions",
      "camera framing has no visible terrain edge or horizon break",
      "motion variety",
      "forest-floor detail reads as organic rather than circular color patches",
      "background contrast without visual clutter",
      "absence of flicker or clipping"
    ]
  }
}
